    "query": "SELECT headline, concept_body FROM radar_concepts WHERE user_id = '{{ $json.user_id }}'::uuid AND source_id = '{{ $json.source_id }}'::uuid AND status = 'dropped' ORDER BY created_at DESC LIMIT 20",
    "options": {}
   },
