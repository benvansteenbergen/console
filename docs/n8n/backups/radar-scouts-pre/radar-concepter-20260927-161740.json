     "name": "Postgres account"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const input = $('Execute Workflow Trigger').first().json;\nconst prunedItems = $input.all().map(i => i.json);\nconst prunedList = prunedItems.filter(p => p.headline).map(p => '- ' + p.headline).join('\\n') || 'None';\n\nreturn [{ json: {\n  ...input,\n  prunedList,\n  query: 'Article from ' + input.source_name + ':\\nURL: ' + input.article_url + '\\nTitle: ' + input.article_title + '\\n\\n' + input.article_text\n}}];"
   },
   "id": "6ed8d9d5-a14c-4782-95e1-2f914a45605f",
   "name": "Build Context",
   "type": "n8n-nodes-base.code",
