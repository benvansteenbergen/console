  {
   "parameters": {
    "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet files = {};\nfor (const list of $input.all()) {\n  for(const item of list.json.objects){\n    let i = item.properties.document_id;\n    if(i == null) continue;\n    if(files[i] == null) { \n      files[i] = {};\n      files[i]['chunks'] = 0;\n    }\n    files[i]['id'] = item.properties.document_id;\n    files[i]['title'] = item.properties.document_title;\n    files[i]['date'] = item.creationTimeUnix;\n    files[i]['visibility'] = item.properties.visibility;\n    files[i]['canDelete'] = (item.properties.uploaded_by == $('Fetch User').first().json.user_id) ? \"true\" : \"false\";\n    files[i]['tenant'] = item.tenant;\n    files[i]['chunks'] = files[i]['chunks'] + 1;\n    files[i]['cluster'] = item.properties.cluster;\n}}\n\nreturn files;"
   },
